{
	"name": "shepherd development",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/node:": {
			"version": "26"
		},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/devcontainers/features/rust:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer"
			],
			"settings": {
				"rust-analyzer.server.path": "/usr/local/cargo/bin/rust-analyzer"
			}
		}
	},
	"mounts": [
		"source=claude-code-config,target=/home/vscode/.claude,type=volume",
		"source=codex-config,target=/home/vscode/.codex,type=volume",
		"source=opencode-config,target=/home/vscode/.config/opencode,type=volume"
	],
	"remoteUser": "vscode",
	"postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/post-create.sh"
}
